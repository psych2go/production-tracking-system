generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  wwUserId   String   @unique(map: "ww_user_id") @map("ww_user_id")
  name       String
  department String?
  role       String   @default("worker") // admin, worker
  avatarUrl  String?  @map("avatar_url")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  batchesCreated   Batch[]            @relation("BatchCreator")
  batchesCarded    Batch[]            @relation("BatchCardCreator")
  batchesStarted   Batch[]            @relation("BatchStarter")
  batchesCancelled Batch[]            @relation("BatchCanceller")
  batchesPaused    Batch[]            @relation("BatchPauser")
  pausesStarted    BatchPauseRecord[] @relation("PauseStarter")
  pausesEnded      BatchPauseRecord[] @relation("PauseEnder")
  progressRecords  ProgressRecord[]   @relation("ProgressOperator")
  auditLogs        AuditLog[]

  @@map("users")
}

model Product {
  id              Int      @id @default(autoincrement())
  model           String
  modelNormalized String?  @unique @map("model_normalized")
  name            String?
  description     String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  batches Batch[]

  @@map("products")
}

model Batch {
  id                     Int       @id @default(autoincrement())
  batchNo                String?   @map("batch_no")
  batchNoNormalized      String?   @map("batch_no_normalized")
  productModelNormalized String?   @map("product_model_normalized")
  orderIdentity          String?   @unique(map: "order_identity_unique") @map("order_identity")
  productId              Int?      @map("product_id")
  quantity               Int       @default(0)
  status                 String    @default("active") // pending_card, pending, active, completed, archived, cancelled
  priority               String    @default("normal") // normal, urgent
  customerCode           String?   @map("customer_code")
  orderNo                String?   @map("order_no")
  packageType            String?   @map("package_type")
  customerDelivery       DateTime? @map("customer_delivery")
  productionDelivery     DateTime? @map("production_delivery")
  notes                  String?
  createdBy              Int?      @map("created_by")
  cardCreatedBy          Int?      @map("card_created_by")
  cardCreatedAt          DateTime? @map("card_created_at")
  startedBy              Int?      @map("started_by")
  startedAt              DateTime? @map("started_at")
  cancelledBy            Int?      @map("cancelled_by")
  cancelledAt            DateTime? @map("cancelled_at")
  pausedBy               Int?      @map("paused_by")
  pausedAt               DateTime? @map("paused_at")
  pauseReason            String?   @map("pause_reason")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  product         Product?           @relation(fields: [productId], references: [id])
  creator         User?              @relation("BatchCreator", fields: [createdBy], references: [id])
  cardCreator     User?              @relation("BatchCardCreator", fields: [cardCreatedBy], references: [id])
  starter         User?              @relation("BatchStarter", fields: [startedBy], references: [id])
  canceller       User?              @relation("BatchCanceller", fields: [cancelledBy], references: [id])
  pauser          User?              @relation("BatchPauser", fields: [pausedBy], references: [id])
  progressRecords ProgressRecord[]
  pauseRecords    BatchPauseRecord[]

  @@unique([batchNo, productId], map: "batch_no_product_unique")
  @@unique([batchNoNormalized, productModelNormalized], map: "batch_identity_normalized_unique")
  @@index([customerCode, orderNo], map: "customer_order_idx")
  @@map("batches")
}

model BatchPauseRecord {
  id        Int       @id @default(autoincrement())
  batchId   Int       @map("batch_id")
  reason    String
  startedBy Int       @map("started_by")
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  endedBy   Int?      @map("ended_by")
  createdAt DateTime  @default(now()) @map("created_at")

  batch   Batch @relation(fields: [batchId], references: [id])
  starter User  @relation("PauseStarter", fields: [startedBy], references: [id])
  ender   User? @relation("PauseEnder", fields: [endedBy], references: [id])

  @@index([batchId], map: "batch_pause_records_batch_idx")
  @@map("batch_pause_records")
}

model ProcessStage {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  stageOrder  Int     @unique(map: "stage_order") @map("stage_order")
  isQcStage   Boolean @default(false) @map("is_qc_stage")
  description String?

  progressRecords ProgressRecord[]

  @@map("process_stages")
}

model ProgressRecord {
  id         Int      @id @default(autoincrement())
  batchId    Int      @map("batch_id")
  stageId    Int      @map("stage_id")
  operatorId Int      @map("operator_id")
  status     String   @default("completed") // completed, in_progress
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  batch    Batch        @relation(fields: [batchId], references: [id])
  stage    ProcessStage @relation(fields: [stageId], references: [id])
  operator User         @relation("ProgressOperator", fields: [operatorId], references: [id])

  @@unique([batchId, stageId], map: "batch_stage_unique")
  @@map("progress_records")
}

model PackageType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  category  String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("package_types")
}

model CustomerCode {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String?
  type      String? // internal, external
  createdAt DateTime @default(now()) @map("created_at")

  @@map("customer_codes")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  action    String // create, update, delete, login...
  entity    String // batch, progress, user, stage...
  entityId  Int?     @map("entity_id")
  detail    String? // JSON
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
